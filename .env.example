# Copy to .env and fill in. The .env file is gitignored — never commit secrets.

# Discord incoming webhook for SOC alerts (Server Settings → Integrations →
# Webhooks → New Webhook → Copy Webhook URL).
DISCORD_WEBHOOK_URL=

# Set to 1 to also echo alerts to the server console (handy for demos).
AEGIS_NOTIFY_CONSOLE=0

# Optional: set to use the Claude-driven SOC analyst instead of the
# deterministic one. Leave unset to run fully offline.
ANTHROPIC_API_KEY=
