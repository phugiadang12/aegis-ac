diff --git a/source/src/console.cpp b/source/src/console.cpp
index 96636e6..a9615f9 100644
--- a/source/src/console.cpp
+++ b/source/src/console.cpp
@@ -1,6 +1,7 @@
 // console.cpp: the console buffer, its display, and command line control
 
 #include "cube.h"
+#include "aegis_lab.h" // Aegis AC lab build only
 
 #define CONSPAD (FONTH/3)
 
@@ -595,6 +596,9 @@ void processtextinput(const char *text)
 
 void keypress(int keycode, int scancode, bool isdown, SDL_Keymod mod)
 {
+#ifdef AEGIS_LAB
+    if(!saycommandon && aegis_lab_key(keycode, isdown)) return; // Aegis AC lab menu
+#endif
     keym *haskey = keyms.access(keycode);
     if(!haskey && !(keycode & SDLK_SCANCODE_MASK) && scancode) haskey = keyms.access(scancode | SDLK_SCANCODE_MASK); // keycode not found: maybe we know the scancode
     if(!haskey && isdown) haskey = autokeymap(keycode, scancode);
